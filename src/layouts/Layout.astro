  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header" data-header>
    <div class="site-header__inner">
      <a class="logo" href="/#top" aria-label={`${site.name}, home`}>
        <img src="/img/logo-black.svg" alt={site.logoAlt} width="1400" height="707">
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="visually-hidden">Menu</span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Main" data-nav>
        <ul class="site-nav__list">
          {sections.map((x) => <li><a href={x.href}>{x.nav}</a></li>)}
        </ul>
        <div class="site-nav__social">
          <span class="site-nav__label">Listen / Follow</span>
          {chips.map((c) => (
            <a class="social-chip" href={c.href} rel="me noopener noreferrer" target="_blank" aria-label={c.label}><svg class="social-chip__icon" aria-hidden="true"><use href={`#i-${c.id}`}/></svg></a>
          ))}
        </div>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__top">
        <div class="site-footer__brand">
          <img class="site-footer__wordmark" src="/img/logo-black.svg" alt={site.name} width="1400" height="707" loading="lazy">
          <p>{site.footerBlurb}</p>
        </div>
        <nav class="site-footer__col" aria-label="Site index">
          <h2>Site</h2>
          <ul>
            {sections.map((x) => <li><a href={x.href}>{x.index}</a></li>)}
          </ul>
        </nav>
        <nav class="site-footer__col" aria-label="Listen and follow">
          <h2>Listen / Follow</h2>
          <ul>
            {footerLinks.map((l) => <li><a href={l.href} rel="me noopener noreferrer" target="_blank">{l.label}</a></li>)}
          </ul>
        </nav>
        <nav class="site-footer__col" aria-label="Legal">
          <h2>Legal</h2>
          <ul>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Use</a></li>
            <li><a href="/cookies">Cookie Policy</a></li>
          </ul>
        </nav>
      </div>
    </div>
    <div class="site-footer__bar">
      <div class="container">
        <p>&copy; <span data-year>2026</span> {legal.responsibleParty || site.name}. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>
