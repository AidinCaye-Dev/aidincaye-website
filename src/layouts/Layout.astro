---
import site from '../content/site.json';
import links from '../content/links.json';
import legal from '../content/legal.json';
const SITE = (Astro.site?.origin || `https://${site.domain}`);
const {
  title = site.title,
  description = site.description,
  path = "/",
  jsonLd = null,
  noindex = false,
} = Astro.props;
const canonical = SITE + (path === '/' ? '/' : path.replace(/\/?$/, ''));
const ogImage = SITE + '/img/og-image.jpg';
// JSON-LD is data (never executed). "<" is escaped so the block can never be closed early.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
// Only https links to the expected platform are shown, so a bad edit can never add a strange link to the header.
const ok = (u: string, re: RegExp) => (typeof u === 'string' && re.test(u) ? u : '');
const chips = [
  { id: 'instagram', label: 'Instagram', href: ok(links.instagram, /^https:\/\/(www\.)?instagram\.com\//) },
  { id: 'youtube', label: 'YouTube', href: ok(links.youtube, /^https:\/\/(www\.)?youtube\.com\//) },
  { id: 'spotify', label: 'Spotify', href: ok(links.spotify, /^https:\/\/open\.spotify\.com\//) },
  { id: 'applemusic', label: 'Apple Music', href: ok(links.appleMusic, /^https:\/\/music\.apple\.com\//) },
].filter((c) => c.href);
// Footer "Listen / Follow" column: every platform with a valid link, including SoundCloud and Facebook.
const footerLinks = [
  ...chips.map((c) => ({ label: c.label, href: c.href })),
  { label: 'SoundCloud', href: ok((links as any).soundcloud, /^https:\/\/(www\.)?soundcloud\.com\//) },
  { label: 'Facebook', href: ok((links as any).facebook, /^https:\/\/(www\.)?facebook\.com\//) },
  { label: 'TikTok', href: ok((links as any).tiktok, /^https:\/\/(www\.)?tiktok\.com\/@/) },
].filter((l) => l.href);
// One list drives both the menu and the footer index, in the same order as the sections on the page.
const sections = [
  { href: '/#music', nav: 'Music', index: 'Music' },
  { href: '/#dates', nav: 'Shows', index: 'Upcoming Shows' },
  { href: '/#about', nav: 'About', index: 'The Story' },
  { href: '/#visuals', nav: 'Gallery', index: 'Gallery' },
  { href: '/#contact', nav: 'Contact', index: 'Contact & Bookings' },
];
// Changes on every deploy so browsers never keep an old copy of the script or styles.
const buildId = Date.now().toString(36);
---
<!doctype html>
<html lang="en-ZA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex ? <meta name="robots" content="noindex,follow"> : <meta name="robots" content="index,follow,max-image-preview:large">}
  <meta name="theme-color" content="#f4f3f0">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:locale" content="en_ZA">
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={`${site.name}, ${site.role.replace(" / ", " and ").toLowerCase()} from ${site.location.split(",")[0]}`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  {jsonLdText && <script type="application/ld+json" set:html={jsonLdText}></script>}
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/img/favicon-48.png" sizes="48x48" type="image/png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
    <link rel="preload" href="/fonts/jost-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/jost-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href={`/css/styles.css?v=${buildId}`}>
  <script src={`/js/main.js?v=${buildId}`} defer></script>
</head>
<body>
