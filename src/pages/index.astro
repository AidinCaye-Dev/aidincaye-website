---
import Layout from '../layouts/Layout.astro';
import links from '../content/links.json';
import site from '../content/site.json';
import manualReleases from '../content/releases.json';
import autoReleases from '../content/releases.auto.json';
import rawShows from '../content/shows.json';
import { cleanShows } from '../../scripts/shows.mjs';
import video from '../content/latest-video.json';
import gallery from '../content/gallery.json';
import accoladesRaw from '../content/accolades.json';
import statsAuto from '../content/stats.auto.json';
import statsManual from '../content/stats.manual.json';
import bioRaw from '../content/bio.md?raw';
import numbersRaw from '../content/numbers.json';

// Latest releases come from Spotify / Apple Music at build time; releases.json is a manual fallback.
const releases = ((autoReleases as any[]).length ? autoReleases : manualReleases).slice(0, 4) as any[];
// Per-release platform links. The release's own URL is exact for its source platform; the others fall back to a search for the title.
const platformLinks = (r: { title: string; url?: string }) => {
  const q = encodeURIComponent(`${r.title} ${site.name}`);
  const u = r.url || '';
  return [
    { id: 'spotify', name: 'Spotify', icon: 'i-spotify', href: /^https:\/\/open\.spotify\.com\//.test(u) ? u : `https://open.spotify.com/search/${q}` },
    { id: 'apple', name: 'Apple Music', icon: 'i-applemusic', href: /^https:\/\/music\.apple\.com\//.test(u) ? u : `https://music.apple.com/za/search?term=${q}` },
    { id: 'ytm', name: 'YouTube Music', icon: 'i-youtube', href: `https://music.youtube.com/search?q=${q}` },
  ];
};
const videoTitle = video.title || 'Latest video';
const videoId = /^[A-Za-z0-9_-]{11}$/.test(video.id || '') ? video.id : '';
const weekdays = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
// Invalid entries are dropped here (and fail `npm test`), so a bad edit can never reach the page.
// Accolades: plain text only, bounded, so a bad edit can never break the page.
const t = (v: unknown, n: number) => String(v ?? '').replace(/[<>]/g, '').trim().slice(0, n);
const accolades = (Array.isArray(accoladesRaw) ? accoladesRaw : [])
  .map((a: any) => ({ badge: t(a.badge, 14), year: /^\d{4}$/.test(String(a.year)) ? String(a.year) : '', title: t(a.title, 80), detail: t(a.detail, 220) }))
  .filter((a) => a.title).slice(0, 12);
// "By the numbers": YouTube/Instagram update themselves each night; Spotify/Apple totals are typed in by hand (stats.manual.json).
const whole = (v: unknown) => { const n = Number(v); return Number.isFinite(n) && n > 0 && n < 1e12 ? Math.floor(n) : 0; };
const short = (n: number) => n >= 1e6 ? `${Math.floor(n / 1e5) / 10}M+`.replace('.0M', 'M') : n >= 1e3 ? `${Math.floor(n / 100) / 10}K+`.replace('.0K', 'K') : String(n);
const sa: any = statsAuto || {}, sm: any = statsManual || {};
const monthLabel = (iso: string) => /^\d{4}-\d{2}(-\d{2})?$/.test(iso || '') ? new Date(iso.slice(0, 7) + '-15T12:00:00Z').toLocaleDateString('en-ZA', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
const statTiles = [
  { n: whole(sm.spotifyStreams), label: 'Spotify streams', as: monthLabel(sm.asOf) },
  { n: whole(sm.appleMusicStreams), label: 'Apple Music streams', as: monthLabel(sm.asOf) },
  { n: whole(sa.youtube?.views), label: 'YouTube views', as: monthLabel(sa.youtube?.updated) },
  { n: whole(sa.instagram?.followers), label: 'Instagram followers', as: monthLabel(sa.instagram?.updated) },
].filter((t) => t.n > 0).map((t) => ({ ...t, value: short(t.n) }));
// Only https links to the expected platform are used anywhere on the page.
const ok = (u: unknown, re: RegExp) => (typeof u === 'string' && re.test(u) ? u : '');
const platforms = [
  { name: 'Spotify', icon: 'spotify', href: ok(links.spotify, /^https:\/\/open\.spotify\.com\//) },
  { name: 'Apple Music', icon: 'applemusic', href: ok(links.appleMusic, /^https:\/\/music\.apple\.com\//) },
  { name: 'YouTube', icon: 'youtube', href: ok(links.youtube, /^https:\/\/(www\.)?youtube\.com\//) },
  { name: 'SoundCloud', icon: 'soundcloud', href: ok((links as any).soundcloud, /^https:\/\/(www\.)?soundcloud\.com\//) },
  { name: 'Instagram', icon: 'instagram', href: ok(links.instagram, /^https:\/\/(www\.)?instagram\.com\//) },
  { name: 'Facebook', icon: 'facebook', href: ok((links as any).facebook, /^https:\/\/(www\.)?facebook\.com\//) },
  { name: 'TikTok', icon: 'tiktok', href: ok((links as any).tiktok, /^https:\/\/(www\.)?tiktok\.com\/@/) },
].filter((p) => p.href);
const youtubeHref = platforms.find((p) => p.name === 'YouTube')?.href || '';
const streamLinks = platforms.filter((p) => p.name === 'Spotify' || p.name === 'Apple Music');
const SITE = `https://${site.domain}`;
// The Story: plain paragraphs from bio.md (only *italics* are kept); the first two show, the rest open with "Read more".
const escHtml = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const bioParas = String(bioRaw).split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)
  .map((p) => escHtml(p.replace(/\s+/g, ' ')).replace(/\*([^*]+)\*/g, '<em>$1</em>'));
const bioLead = bioParas.slice(0, 2);
const bioMore = bioParas.slice(2);
// Headline numbers for Highlights: short value + label, plain text only.
const numbers = (Array.isArray(numbersRaw) ? numbersRaw : [])
  .map((n: any) => ({ value: String(n.value || '').slice(0, 8), label: String(n.label || '').slice(0, 40) }))
  .filter((n) => n.value && n.label && !/[<>]/.test(n.value + n.label)).slice(0, 4);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: site.name, inLanguage: 'en-ZA' },
    {
      '@type': 'Person', '@id': `${SITE}/#artist`, name: site.name,
      url: `${SITE}/`, image: `${SITE}/img/og-image.jpg`,
      jobTitle: ['DJ', 'Music producer'], genre: site.genres,
      homeLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: 'Johannesburg', addressCountry: 'ZA' } },
      sameAs: platforms.map((p) => p.href),
    },
  ],
};
const bookingEmail = /^[^\s@<>"]+@[^\s@<>"]+\.[a-z]{2,}$/i.test(site.bookingEmail || '') ? site.bookingEmail : '';

const { shows, problems: showProblems } = cleanShows(rawShows);
if (showProblems.length) console.warn('[shows] ignored:', showProblems.join('; '));
const upcoming = shows
  .filter((s) => s.date && new Date(s.date + 'T23:59:59+02:00') >= new Date())
  .sort((a, b) => a.date.localeCompare(b.date));
// The Turnstile site key is public by design (it is printed in the page), so it lives in site.json. An env var can override it.
const rawKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || site.turnstileSiteKey || '';
const turnstileKey = /^[0-9A-Za-z_-]{10,60}$/.test(rawKey) ? rawKey : '';
---

<Layout path="/" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__media">
      <picture>
        <source media="(max-width: 1100px) and (orientation: portrait), (max-width: 700px)" type="image/avif" srcset="/img/hero-m-900.avif 900w, /img/hero-m-1036.avif 1036w" sizes="100vw">
        <source media="(max-width: 1100px) and (orientation: portrait), (max-width: 700px)" type="image/webp" srcset="/img/hero-m-900.webp 900w, /img/hero-m-1036.webp 1036w" sizes="100vw">
        <source media="(max-width: 1100px) and (orientation: portrait), (max-width: 700px)" srcset="/img/hero-m-900.jpg 900w, /img/hero-m-1036.jpg 1036w" sizes="100vw">
        <source type="image/avif" srcset="/img/hero-900.avif 900w, /img/hero-1600.avif 1600w, /img/hero-2576.avif 2576w" sizes="100vw">
        <source type="image/webp" srcset="/img/hero-900.webp 900w, /img/hero-1600.webp 1600w, /img/hero-2576.webp 2576w" sizes="100vw">
        <img class="hero__photo" src="/img/hero-1600.jpg" srcset="/img/hero-900.jpg 900w, /img/hero-1600.jpg 1600w, /img/hero-2576.jpg 2576w" sizes="100vw" width="2576" height="1382" alt="" fetchpriority="high">
      </picture>
    </div>
    <div class="hero__content">
      <h1 class="hero__title" id="hero-title">
        <img src="/img/logo-black.svg" alt={site.logoAlt} width="1400" height="707">
      </h1>
      <p class="hero__role">{site.role}</p>
    </div>
    <div class="hero__footer">
      <p class="hero__location">
        <svg class="icon icon--pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
        {site.location}
      </p>
      <div class="hero__actions">
        <a class="btn btn--outline" href="#music">Listen</a>
        <a class="btn btn--solid" href="#contact">Book now
          <svg class="icon icon--arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h16m-6-6 6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- MUSIC -->
  <section class="section section--music" id="music" aria-labelledby="music-title">
    <div class="container">
      {videoId ? (<>
      <header class="section-head">
        <h2 class="section-title" id="music-title">New Official Clip</h2>
      </header>
      <div class="video-facade" data-video-id={videoId} data-video-title={videoTitle}>
        <img class="video-facade__poster" src={video.thumb || '/img/video-poster-placeholder.svg'} alt="" width="1280" height="720" loading="lazy">
        <button class="video-facade__play" type="button" aria-label={`Play video: ${videoTitle}`}>
          <svg class="video-facade__yt" viewBox="0 0 68 48" aria-hidden="true"><path class="video-facade__yt-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"/><path class="video-facade__yt-arrow" d="M45 24 27 14v20z"/></svg>
        </button>
        <div class="video-facade__meta">
          <span class="tag">Latest video</span>
          <h3 class="video-facade__title">{videoTitle}</h3>
          <p class="video-facade__note">Plays from YouTube. Loading the video shares data with Google.</p>
        </div>
      </div>
      <header class="section-head section-head--row">
        <h2 class="section-title section-title--sm">Latest Releases</h2>
        <a class="link-arrow" href="#listen">All platforms
          <svg class="icon icon--arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h16m-6-6 6 6-6 6"/></svg>
        </a>
      </header>
      </>) : (
      <header class="section-head section-head--row">
        <div>
          <h2 class="section-title" id="music-title">Latest Releases</h2>
        </div>
        <a class="link-arrow" href="#listen">All platforms
          <svg class="icon icon--arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h16m-6-6 6 6-6 6"/></svg>
        </a>
      </header>
      )}
      {releases.length ? (
      <ul class="release-grid">
        {releases.map((r) => (
          <li class="release" data-release>
            <a class="release__link" href={r.url} rel="noopener noreferrer" target="_blank" aria-haspopup="true" aria-expanded="false" data-release-toggle>
              <span class="release__cover"><img src={r.cover} alt={`Cover art for ${r.title}`} width="600" height="600" loading="lazy"></span>
              <span class="release__type">{r.type} · {r.year}</span>
              <span class="release__title">{r.title}</span>
              {r.label && <span class="release__label">{r.label}</span>}
            </a>
            <div class="release__chooser" role="group" aria-label={`Listen to ${r.title} on`} hidden data-release-chooser>
              <p class="release__chooser-title">Listen on</p>
              {platformLinks(r).map((pl) => (
                <a class="release__platform" href={pl.href} rel="noopener noreferrer" target="_blank">
                  <svg class="release__platform-icon" aria-hidden="true"><use href={`#${pl.icon}`}/></svg>
                  <span>{pl.name}</span>
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
      ) : (
      <p class="empty-note">Find the latest releases on {streamLinks.map((p, i) => <>{i > 0 && ' and '}<a href={p.href} rel="noopener noreferrer" target="_blank">{p.name}</a></>)}.</p>
      )}
    </div>
  </section>

  <!-- DATES -->
  <section class={`section section--dates${upcoming.length ? '' : ' section--compact'}`} id="dates" aria-labelledby="dates-title">
    <div class="container">
      <header class="section-head section-head--row">
        <div>
          <h2 class="section-title" id="dates-title">Upcoming Shows</h2>
        </div>
        <p class="section-aside">All times SAST</p>
      </header>
      {upcoming.length ? (
      <ol class="show-list">
        {upcoming.map((s, i) => {
          const d = new Date(s.date + 'T12:00:00+02:00');
          const when = weekdays[d.getUTCDay()] + (s.time ? ' · ' + s.time : '');
          const next = i === 0;
          return (
          <li class:list={['show', next && 'show--next']}>
            <time class="show__date" datetime={s.date + (s.time ? 'T' + s.time + ':00+02:00' : '')}>
              <span class="show__day">{String(d.getUTCDate()).padStart(2, '0')}</span>
              <span class="show__month">{months[d.getUTCMonth()].toUpperCase()} {d.getUTCFullYear()}</span>
              <span class="show__when">{when}</span>
            </time>
            <div class="show__info">
              {next && <p class="show__next">Next up</p>}
              <p class="show__venue">{s.venue}</p>
              <p class="show__city">{s.city}{s.event ? ' · ' + s.event : ''}</p>
            </div>
            {s.status === 'soldout'
              ? <span class="btn btn--small btn--disabled" aria-disabled="true">Sold out</span>
              : s.url ? <a class={'btn btn--small' + (next ? ' btn--solid' : '')} href={s.url} rel="noopener noreferrer" target="_blank">{s.status === 'free' ? 'Details' : 'Tickets'}</a>
              : s.status === 'free' ? <span class="show__free">Free entry</span> : null}
          </li>
          );
        })}
      </ol>
      ) : (
      <p class="show-empty">No dates announced right now. <a href="#contact">Book {site.name}</a> for your event.</p>
      )}
    </div>
  </section>

  <!-- STORY -->
  <section class="section section--about" id="about" aria-labelledby="about-title">
    <div class="container about">
      <figure class="about__media">
        <img src="/images/portrait.jpg" alt={`Portrait of ${site.name}`} width="900" height="1350" loading="lazy">
      </figure>
      <div class="about__text">
        <h2 class="section-title" id="about-title">The Story</h2>
        <div class="about__body">
          {bioLead.map((p) => <p set:html={p} />)}
          {bioMore.length > 0 && (
            <details class="about__more">
              <summary><span class="about__more-open">Read more</span><span class="about__more-close">Read less</span></summary>
              {bioMore.map((p) => <p set:html={p} />)}
            </details>
          )}
        </div>
        <dl class="about__facts">
          <div><dt>Based</dt><dd>Johannesburg</dd></div>
          <div><dt>Sound</dt><dd>House &amp; techno</dd></div>
        </dl>
      </div>
    </div>
    {(accolades.length > 0 || statTiles.length > 0 || numbers.length > 0) && (
    <div class="container accolades" aria-labelledby="accolades-title">
      <h3 class="accolades__title" id="accolades-title">Highlights</h3>
      {statTiles.length > 0 && (
        <ul class="stats" aria-label="By the numbers">
          {statTiles.map((t) => (
            <li class="stat"><p class="stat__value">{t.value}</p><p class="stat__label">{t.label}</p>{t.as && <p class="stat__as">as of {t.as}</p>}</li>
          ))}
        </ul>
      )}
      {numbers.length > 0 && (
        <ul class="numbers" aria-label="By the numbers">
          {numbers.map((n) => <li class="number"><span class="number__value">{n.value}</span><span class="number__label">{n.label}</span></li>)}
        </ul>
      )}
      <dl class="facts-list">
        {accolades.filter((a) => !/^(streams|shazam)$/i.test(a.badge)).map((a) => (
          <div class="facts-list__row">
            <dt>{a.title}{a.year && <span class="accolade__year"> · {a.year}</span>}</dt>
            {a.detail && <dd>{a.detail}</dd>}
          </div>
        ))}
      </dl>
    </div>
  )}
  </section>

  <!-- VISUALS -->
  <section class="section section--visuals" id="visuals" aria-labelledby="visuals-title">
    <div class="container">
      <header class="section-head">
        <h2 class="section-title" id="visuals-title">Gallery</h2>
      </header>
      <ul class="gallery">
        {gallery.map((g, i) => (
          <li class="gallery__item">
            {g.url
              ? <a href={g.url} rel="noopener noreferrer" target="_blank" aria-label={`${g.alt} (opens Instagram)`}><img src={g.src} alt={g.alt} width="1080" height="1080" loading="lazy"></a>
              : <img src={g.src} alt={g.alt} width="1600" height="900" loading="lazy">}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- LISTEN / FOLLOW -->
  <section class="section section--listen" id="listen" aria-labelledby="listen-title">
    <div class="container">
      <h2 class="visually-hidden" id="listen-title">Listen and follow</h2>
      <p class="listen__label">Listen and follow</p>
      <ul class="platforms">
        {platforms.map((p) => <li><a href={p.href} rel="me noopener noreferrer" target="_blank"><svg class="platforms__icon" aria-hidden="true" focusable="false"><use href={`#i-${p.icon}`}/></svg>{p.name}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- BOOKINGS -->
  <section class="section section--contact" id="contact" aria-labelledby="contact-title">
    <div class="container contact">
      <div class="contact__intro">
        <h2 class="section-title" id="contact-title">Bookings</h2>
        <p>For club nights, festivals and private events, send the details below and his team will come back to you.</p>
        {bookingEmail && (
        <dl class="contact__lines">
          <div><dt>Bookings</dt><dd><a href={`mailto:${bookingEmail}`}>{bookingEmail}</a></dd></div>
        </dl>
        )}
      </div>

      <form class="form" action="/api/booking" method="post" novalidate data-booking-form>
        <div class="form__row">
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100">
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200">
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label for="f-org">Organisation / promoter</label>
            <input id="f-org" name="organisation" type="text" autocomplete="organization" maxlength="120">
          </div>
          <div class="field">
            <label for="f-date">Event date</label>
            <input id="f-date" name="event_date" type="date">
          </div>
        </div>
        <div class="field">
          <label for="f-venue">Venue &amp; city</label>
          <input id="f-venue" name="venue" type="text" maxlength="160">
        </div>
        <div class="field">
          <label for="f-msg">Message</label>
          <textarea id="f-msg" name="message" rows="5" required maxlength="1000"></textarea>
        </div>
        <div class="field field--hp" aria-hidden="true">
          <label for="f-website">Website</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off">
        </div>
        <div class="form__turnstile" data-turnstile-slot>
          {turnstileKey && <div data-turnstile-widget data-sitekey={turnstileKey}></div>}
        </div>
        <p class="form__privacy">We only use these details to respond to your enquiry. See our <a href="/privacy">Privacy Policy</a>.</p>
        <button class="btn btn--solid" type="submit">Send enquiry
          <svg class="icon icon--arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h16m-6-6 6 6-6 6"/></svg>
        </button>
        <div class="form__status" role="status" aria-live="polite" tabindex="-1" hidden data-form-status></div>
      </form>
    </div>
  </section>
</Layout>
